  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest",
    "qrcode": "latest"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
