{
  "name": "combine-card-game-client-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node server.js",
